{
  "id": "/app/",
  "name": "{{APP_NAME}}",
  "short_name": "{{SHORT_NAME}}",
  "description": "Turn long WhatsApp voice notes into three-line summaries. Urdu, Punjabi and English.",
  "start_url": "/app/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F1F0E8",
  "theme_color": "#0F2A1F",
  "lang": "en",
  "categories": ["utilities", "productivity", "social"],
  "icons": [
    { "src": "/assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/assets/img/og-image.png", "sizes": "1200x630", "type": "image/png", "form_factor": "wide", "label": "A long voice note summarized in three lines" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "audio", "accept": ["audio/*", ".opus", ".ogg", ".oga", ".m4a", ".mp3", ".wav", ".aac", ".amr"] }]
    }
  }
}
